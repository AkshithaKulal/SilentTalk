# Ignore heavy weight files globally, then allow Stage 2 LoRA checkpoint artifacts
**/*.safetensors
!**/stage2_output/**/*.safetensors
!**/stage2_kn_tcy_output/**/*.safetensors
!**/stage2_synthetic_brx_output/**/*.safetensors
**/*.bin
!**/stage2_output/**/*.bin
!**/stage2_kn_tcy_output/**/*.bin
!**/stage2_synthetic_brx_output/**/*.bin

# Large datasets
**/samanantar_en_kn.csv
**/stage1_data/
**/stage2_data/
**/*.csv.bak

# ISL / MediaPipe Track 2 — keep code, ignore heavy outputs + models
isl_recognition/landmarks/
isl_recognition/landmarks_smoke/
isl_recognition/models/*.task
isl_recognition/artifacts/*
!isl_recognition/artifacts/tulu_sentence_map_kn.json

# Self-recorded ISL videos (keep folder tree + labels.csv; ignore media)
raw_video/**/*.mp4
raw_video/**/*.mov
raw_video/**/*.avi
raw_video/**/*.mkv


# Training outputs / checkpoints
# Stage 1 full runs can be large — keep ignored; Stage 2 LoRA checkpoint is small enough to push
**/stage1_output/
**/runs/
**/wandb/

