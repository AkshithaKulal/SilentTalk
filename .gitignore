# Python / env
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.log

# Hugging Face / models (re-download on the other machine)
**/model_cache/
**/pytorch_model.bin

# Ignore heavy weight files globally, then allow Stage 2 LoRA checkpoint artifacts
**/*.safetensors
!**/stage2_output/**/*.safetensors
**/*.bin
!**/stage2_output/**/*.bin

# Large datasets
**/samanantar_en_kn.csv
**/stage1_data/
**/stage2_data/
**/*.csv.bak

# ISL / MediaPipe Track 2 — keep code, ignore heavy outputs + models
isl_recognition/landmarks/
isl_recognition/models/*.task

# Training outputs / checkpoints
# Stage 1 full runs can be large — keep ignored; Stage 2 LoRA checkpoint is small enough to push
**/stage1_output/
**/runs/
**/wandb/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Nested git metadata from cloned toolkit if any
IndicTrans2/huggingface_interface/IndicTransToolkit_repo/.git/

# Temporary reports ok to keep small txt; ignore huge dumps
**/tcywiki-latest-pages-articles.xml.bz2
